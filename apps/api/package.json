{
  "name": "@resume-analyzer/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest && jest --config ./test/jest-e2e.json",
    "test:unit": "jest",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "typeorm": "typeorm -d dist/database/data-source.js",
    "migration:generate": "pnpm build && pnpm typeorm migration:generate",
    "migration:run": "pnpm build && pnpm typeorm migration:run",
    "migration:revert": "pnpm build && pnpm typeorm migration:revert"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.15",
    "@clerk/backend": "^3.11.6",
    "@nestjs/common": "^11.1.29",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.29",
    "@nestjs/platform-express": "^11.1.29",
    "@nestjs/typeorm": "^11.0.3",
    "ai": "^7.0.29",
    "dotenv": "^16.4.5",
    "jose": "^6.2.3",
    "mammoth": "^1.12.0",
    "nestjs-zod": "^5.5.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.0",
    "unpdf": "^1.4.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.29",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.0.15",
    "@types/supertest": "^7.2.1",
    "jest": "^30.4.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3"
  }
}

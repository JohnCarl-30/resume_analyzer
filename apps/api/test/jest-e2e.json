{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec\\.ts$",
  "transform": {
    "^.+\\.ts$": [
      "ts-jest",
      {
        "tsconfig": "<rootDir>/../tsconfig.json"
      }
    ]
  },
  "moduleNameMapper": {
    "^(\\.{1,2}/.*)\\.js$": "$1",
    "^ai$": "<rootDir>/stubs/ai-sdk.cjs",
    "^@ai-sdk/openai$": "<rootDir>/stubs/ai-sdk.cjs"
  },
  "setupFiles": [
    "<rootDir>/setup-e2e.ts"
  ]
}
